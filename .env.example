# Modelo das variáveis do app. Copie para .env e preencha.
#
# IMPORTANTE: só entram aqui chaves PÚBLICAS (publishable). Elas vão embutidas
# no bundle do browser, então não são segredo. Nunca coloque aqui:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - chaves sb_secret_*
#   - personal access tokens (sbp_*, ghp_*)
# Segredos de verdade ficam em variáveis de ambiente do servidor/Vercel.

SUPABASE_PROJECT_ID="seu-project-ref"
SUPABASE_URL="https://seu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
